  "members": [
    "private static final Logger log = LoggerFactory.getLogger(InMemoryHistoryEventPublisher.class);",
    "private final Sinks.Many<HistoryEvent> sink;",
    "private final Duration emitRetryTimeout;",
    "public InMemoryHistoryEventPublisher(TelemetryProperties properties) { this.sink = Sinks.many().replay().limit(properties.broadcastCapacity()); this.emitRetryTimeout = properties.emitRetryTimeout(); }",
    "@Override public Flux<HistoryEvent> events() { return sink.asFlux(); }"
