  "members": [
    "private final Sinks.Many<TelemetrySample> sink;",
    "public InMemoryTelemetryEventBus(TelemetryProperties properties) { this.sink = Sinks.many().multicast().onBackpressureBuffer(properties.busBufferCapacity()); }",
    "@Override public Flux<TelemetrySample> stream() { return sink.asFlux(); }"
  ],
  "body": "return Mono.defer(() -> {\n    Sinks.EmitResult result;\n    do {\n        result = sink.tryEmitNext(sample);\n    } while (result == Sinks.EmitResult.FAIL_NON_SERIALIZED);\n    if (result.isFailure() && result != Sinks.EmitResult.FAIL_ZERO_SUBSCRIBER) {\n        return Mono.<Void>error(new IllegalStateException(\"Telemetry event bus emit failed: \" + result));\n    }\n    return Mono.<Void>empty();\n});",
