  "path": "src/main/java/com/pulsestream/telemetry/ingestion/application/IngestTelemetryUseCase.java",
  "export": "IngestTelemetryUseCase",
  "intent": "Ingestion use case: refuses samples failing the pinned DeviceBindingPolicy (audited), validates via SensorMetricBoundary, orders by t_device within the reorder window (never t_ingress), appends in batches through the guarded retried store. Dedup identity is (device_id, metric, t_device): identical value is a no-op, a different value appends a revision; then publishes the event and audits. PB-05 batch-load: Reactor bufferTimeout(n, Duration) bounds records per write by the batch-size key.",
  "layer": "application",
  "feature": null,
  "project": "telemetry-ingestion-processing",
  "ast_hints": {
    "package": "com.pulsestream.telemetry.ingestion.application",
    "implements": [],
    "dependencies": [
      {
        "type": "SensorMetricBoundary",
        "task_id": "T2-006"
      },
      {
        "type": "TelemetrySample",
        "task_id": "T2-007"
      },
      {
        "type": "IngestionEvent",
        "task_id": "T2-008"
      },
      {
        "type": "TelemetryRecordStore",
        "task_id": "T2-009"
      },
      {
        "type": "EventPublisher",
        "task_id": "T2-010"
      },
      {
        "type": "AuditPort",
        "task_id": "T2-011"
      },
      {
        "type": "DeviceBindingPolicy",
        "task_id": "T2-013"
      },
      {
        "type": "AppendConcurrencyGuard",
