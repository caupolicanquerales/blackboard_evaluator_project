    "private final MeterRegistry registry",
    "public TelemetryMeters(MeterRegistry registry) { this.registry = Objects.requireNonNull(registry, \"registry\"); }",
    "public void packetReceived(SourceKind sourceKind) { registry.counter(\"telemetry.packets.received\", \"source_kind\", sourceKind.name()).increment(); }",
    "public void sampleValidated(MetricKind metric, ValidationStatus status) { registry.counter(\"telemetry.samples.validated\", \"metric\", metric.name(), \"status\", status.name()).increment(); }",
    "public void sampleReordered(MetricKind metric) { registry.counter(\"telemetry.samples.reordered\", \"metric\", metric.name()).increment(); }",
    "public void revisionAppended(RevisionReason reason) { registry.counter(\"telemetry.revisions.appended\", \"reason\", reason.name()).increment(); }"
