  "signature": "public TelemetryMetrics(MeterRegistry registry)",
  "returns": "void",
  "body": "this.registry = registry;\nregistry.config().meterFilter(new MeterFilter() {\n    @Override\n    public Meter.Id map(Meter.Id id) {\n        if (!id.getName().startsWith(\"telemetry.\")) {\n            return id;\n        }\n        List<Tag> kept = id.getTags().stream()\n                .filter(tag -> Arrays.asList(\"status\", \"metric\", \"reason\", \"outcome\").contains(tag.getKey()))\n                .toList();\n        return id.replaceTags(Tags.of(kept));\n    }\n});",
  "imports": [
    "io.micrometer.core.instrument.Meter",
    "io.micrometer.core.instrument.MeterRegistry",
    "io.micrometer.core.instrument.Tag",
    "io.micrometer.core.instrument.Tags",
    "io.micrometer.core.instrument.config.MeterFilter",
    "java.time.Duration",
    "java.util.Arrays",
    "java.util.List",
    "org.springframework.stereotype.Component"
  ],
  "annotations": [
    "Component"
  ],
  "members": [
    "private final MeterRegistry registry;",
    "private static String closed(String value, String... allowed) { return value != null && Arrays.asList(allowed).contains(value) ? value : \"other\"; }",
    "public void samplesIngested(String status) { registry.counter(\"telemetry.samples.ingested\", \"status\", closed(status, \"accepted\", \"VALIDATED\", \"VALIDATION_FAILED\", \"DUPLICATE\", \"REFUSED\")).increment(); }",
    "public void validationFailed(String metric) { registry.counter(\"telemetry.validation.failed\", \"metric\", closed(metric, \"temperature\", \"humidity\", \"pressure\", \"voltage\", \"current\", \"vibration\")).increment(); }",
    "public void backfillReordered() { registry.counter(\"telemetry.backfill.reordered\").increment(); }",
    "public void revisionAppended(String reason) { registry.counter(\"telemetry.revision.appended\", \"reason\", closed(reason, \"backfill\", \"correction\", \"late\")).increment(); }",
    "public void windowBroadcast(String outcome) { registry.counter(\"telemetry.window.broadcast\", \"outcome\", closed(outcome, \"buffered\", \"broadcast\", \"success\")).increment(); }",
    "public void broadcastDropped(String reason) { registry.counter(\"telemetry.broadcast.dropped\", \"reason\", closed(reason, \"overflow\", \"slow_consumer\", \"timeout\")).increment(); }",
    "public void ingestDuration(String outcome, Duration elapsed) { registry.timer(\"telemetry.ingest.duration\", \"outcome\", closed(outcome, \"success\", \"failure\", \"refused\")).record(elapsed); }"
  ],
