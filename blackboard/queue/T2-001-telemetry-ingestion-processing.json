{
  "id": "T2-001",
  "targetAgent": "agent-coder",
  "stage": 2,
  "dependsOn": [
    "T1-001",
    "T0-001"
  ],
  "kind": "code",
  "path": "src/main/resources/application.yml",
  "export": "application",
  "intent": "The ONE configuration artifact, nested YAML. Base document: spring.flyway.locations classpath:db/migration; bare placeholders TELEMETRY_JDBC_URL and TELEMETRY_R2DBC_URL; ECS JSON file sink logs/telemetry-ingestion-processing.log, rolling max-file-size 10MB, max-history 14. Credential lists boot fail-fast when unseeded. A '---' test profile document, activated by spring.profiles.active=test, seeds embedded H2 and credential entries.",
  "layer": "shared",
  "feature": null,
  "project": "telemetry-ingestion-processing",
  "ast_hints": {
    "package": "com.pulsestream.telemetry.shared",
    "implements": [],
    "dependencies": [],
    "methods": [],
    "meters": [],
    "routes": [],
    "config": [
      {
        "path": "spring.flyway.locations",
        "kind": "value",
        "value": "classpath:db/migration"
      },
      {
        "path": "spring.flyway.url",
        "kind": "value",
        "value": "${TELEMETRY_JDBC_URL}"
      },
      {
        "path": "spring.r2dbc.url",
        "kind": "value",
        "value": "${TELEMETRY_R2DBC_URL}"
      },
      {
        "path": "logging.file.name",
        "kind": "value",
        "value": "logs/telemetry-ingestion-processing.log"
      },
      {
        "path": "logging.structured.format.file",
        "kind": "value",
        "value": "ecs"
      },
      {
        "path": "logging.logback.rollingpolicy.max-file-size",
        "kind": "value",
        "value": "10MB"
      },
      {
        "path": "logging.logback.rollingpolicy.max-history",
        "kind": "value",
        "value": "14"
      },
      {
        "path": "server.error.include-message",
        "kind": "value",
        "value": "never"
      },
      {
        "path": "server.error.include-stacktrace",
        "kind": "value",
        "value": "never"
      },
      {
        "path": "server.error.include-binding-errors",
        "kind": "value",
        "value": "never"
      },
      {
        "path": "management.metrics.tags",
        "kind": "map"
      },
      {
        "path": "telemetry.ingestion.append.permits",
        "kind": "value"
      },
      {
        "path": "telemetry.ingestion.append.retry.max-attempts",
        "kind": "value",
        "value": "3"
      },
      {
        "path": "telemetry.ingestion.append.retry.backoff",
        "kind": "value"
      },
      {
        "path": "telemetry.ingestion.append.timeout",
        "kind": "value"
      },
      {
        "path": "telemetry.ingestion.reorder.window",
        "kind": "value",
        "value": "60s"
      },
      {
        "path": "telemetry.ingestion.batch.size",
        "kind": "value"
      },
      {
        "path": "spring.ssl.bundle.pem.telemetry-payload.keystore.private-key",
        "kind": "value"
      },
      {
        "path": "telemetry.ingestion.page.size",
        "kind": "value"
      },
      {
        "path": "telemetry.ingestion.page.max",
        "kind": "value"
      },
      {
        "path": "spring.r2dbc.pool.max-size",
        "kind": "value"
      },
      {
        "path": "spring.r2dbc.pool.max-idle-time",
        "kind": "value"
      },
      {
        "path": "spring.r2dbc.pool.max-acquire-time",
        "kind": "value"
      },
      {
        "path": "telemetry.ingestion.device-credentials",
        "kind": "list",
        "fields": [
          "id",
          "secret-hash",
          "scope"
        ]
      },
      {
        "path": "spring.codec.max-in-memory-size",
        "kind": "value"
      },
      {
        "path": "telemetry.ingestion.rate.limit",
        "kind": "value"
      },
      {
        "path": "telemetry.ingestion.rate.burst",
        "kind": "value"
      },
      {
        "path": "telemetry.ingestion.reorder.buffer-capacity",
        "kind": "value"
      },
      {
        "path": "telemetry.stream.window.capacity",
        "kind": "value"
      },
      {
        "path": "telemetry.stream.window.duration",
        "kind": "value"
      },
      {
        "path": "telemetry.stream.service-credentials",
        "kind": "list",
        "fields": [
          "id",
          "secret-hash",
          "scope"
        ]
      },
      {
        "path": "telemetry.stream.subscribers.max",
        "kind": "value"
      },
      {
        "path": "telemetry.stream.subscriber.buffer-capacity",
        "kind": "value"
      },
      {
        "path": "telemetry.stream.intake.queue-capacity",
        "kind": "value"
      }
    ]
